{#
  Fixed vertical icon toolbar on the right edge of the viewport (How to
  Use / Inquiry / Compare / Contact Us on lumi.cn), driven by the `sidebar`
  array (built in PlentyTestPlugin\Configs\SidebarConfig). Edit that file
  to change items/links — this file only renders it.
#}
<link rel="stylesheet" href="{{ plugin_path('PlentyTestPlugin') }}/css/sidebar.css">

<div class="ls-sidebar-d5" id="siteSidebar">
  {% for item in sidebar.items %}
    {% if item.action == 'link' %}
      <a class="ls-sidebar-item-d5" href="{{ item.href }}">
    {% else %}
      <button class="ls-sidebar-item-d5" type="button" data-sidebar-guide>
    {% endif %}

      <span class="ls-sidebar-icon-d5">
        {% if item.icon == 'guide' %}
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9.25" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M9.3 9.3a2.7 2.7 0 1 1 3.9 2.4c-.7.4-1.2.9-1.2 1.8v.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="12" cy="17" r="1" fill="currentColor"/></svg>
        {% elseif item.icon == 'inquiry' %}
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 3.5h9l3 3V20a.5.5 0 0 1-.5.5h-11A.5.5 0 0 1 6 20V4a.5.5 0 0 1 .5-.5z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M9 9.5h6M9 13h6M9 16.5h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        {% elseif item.icon == 'compare' %}
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 4v16M16 20V4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M4.5 8L8 4.5 11.5 8M12.5 16L16 19.5 19.5 16" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {% elseif item.icon == 'contact' %}
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 5.5h16a1 1 0 0 1 1 1V17a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6.5a1 1 0 0 1 1-1z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M3.5 6.5 12 13l8.5-6.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {% endif %}
      </span>
      <span class="ls-sidebar-label-d5">{{ item.label }}</span>

    {% if item.action == 'link' %}
      </a>
    {% else %}
      </button>
    {% endif %}
  {% endfor %}
</div>

<script src="{{ plugin_path('PlentyTestPlugin') }}/js/sidebar.js"></script>
