{#
  Storefront header, driven entirely by the `header` array (built in
  PlentyTestPlugin\Configs\HeaderConfig) and the `searchAction` /
  `searchParam` values (backend-configurable via config.json, see
  DemoHomeController). Edit content there — this file only renders it.
#}
<link
  rel="stylesheet"
  type="text/css"
  href="{{ plugin_path('PlentyTestPlugin') }}/css/header.css?v=1"
>

<header class="lh-site-header-d5" id="siteHeader">
  <div class="lh-header-inner-d5">

    <a class="lh-logo-d5" href="{{ header.logo.href }}" aria-label="{{ header.logo.alt }} home">
      <img src="{{ header.logo.src }}" alt="{{ header.logo.alt }}">
    </a>

    <nav class="lh-main-nav-d5" id="mainNav" aria-label="Main navigation">
      <ul class="lh-nav-list-d5">
        {% for item in header.nav %}
          <li class="lh-nav-item-d5{% if item.type in ['dropdown', 'mega'] %} lh-has-panel-d5{% endif %}">
            <a class="lh-nav-link-d5" href="{{ item.href }}"{% if item.type in ['dropdown', 'mega'] %} aria-haspopup="true" aria-expanded="false"{% endif %}>
              {{ item.label }}{% if item.type in ['dropdown', 'mega'] %} <i class="lh-caret-d5"></i>{% endif %}
            </a>

            {% if item.type == 'dropdown' %}
              <div class="lh-dropdown-d5">
                {% for link in item.links %}
                  <a href="{{ link.href }}">{{ link.label }}</a>
                  {% if link.sub is defined and link.sub|length %}
                    <div class="lh-dropdown-sub-d5">
                      {% for sub in link.sub %}
                        <a href="{{ sub.href }}">{{ sub.label }}</a>
                      {% endfor %}
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            {% elseif item.type == 'mega' %}
              <div class="lh-mega-d5">
                <div class="lh-mega-inner-d5">
                  {% for column in item.columns %}
                    <div class="lh-mega-col-d5">
                      {% for block in column %}

                        {% if block.type == 'brand' %}
                          <div class="lh-mega-brand-d5">
                            <a href="{{ block.href }}">
                              <h3>{{ block.label }}</h3>
                              <p>{{ block.desc }}</p>
                            </a>
                          </div>

                        {% elseif block.type == 'group' %}
                          <div class="lh-mega-group-d5">
                            <a href="{{ block.href }}">{{ block.label }}</a>
                            <ul>
                              {% for link in block.items %}
                                <li><a href="{{ link.href }}">{{ link.label }}{% if link.badge is defined %}<span class="lh-tag-new-d5">{{ link.badge }}</span>{% endif %}</a></li>
                              {% endfor %}
                            </ul>
                          </div>

                        {% elseif block.type == 'solutions' %}
                          <h4 class="lh-mega-heading-d5">{{ block.heading }}</h4>
                          <div class="lh-solution-logos-d5">
                            {% for logo in block.logos %}
                              <a href="{{ logo.href }}">
                                <img class="lh-off-d5" src="{{ logo.off }}" alt="{{ logo.alt }}">
                                <img class="lh-on-d5" src="{{ logo.on }}" alt="">
                              </a>
                            {% endfor %}
                          </div>

                        {% elseif block.type == 'news' %}
                          <h4 class="lh-mega-heading-d5">{{ block.heading }} <small>{{ block.headingSmall }}</small></h4>
                          <div class="lh-news-cards-d5">
                            {% for card in block.cards %}
                              <a href="{{ card.href }}">
                                <img src="{{ card.img }}" alt="{{ card.alt }}">
                              </a>
                            {% endfor %}
                          </div>
                        {% endif %}

                      {% endfor %}
                    </div>
                  {% endfor %}
                </div>

                {% if item.quickAccess is defined %}
                  <div class="lh-mega-quick-d5">
                    <div class="lh-mega-quick-inner-d5">
                      <span>{{ item.quickAccess.label }}</span>
                      {% for link in item.quickAccess.links %}
                        <a href="{{ link.href }}">{{ link.label }}</a>
                      {% endfor %}
                    </div>
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </nav>

    <div class="lh-lang-d5" id="langSwitch">
      <button class="lh-lang-toggle-d5" type="button" aria-haspopup="true" aria-expanded="false">
        <img src="{{ header.languages.current.flag }}" alt="">
        <span>{{ header.languages.current.label }}</span>
        <i class="lh-caret-d5"></i>
      </button>
      <div class="lh-lang-menu-d5">
        {% for lang in header.languages.options %}
          <a href="{{ lang.href }}"><img src="{{ lang.flag }}" alt="">{{ lang.label }}</a>
        {% endfor %}
      </div>
    </div>

    <form class="lh-search-d5" role="search" action="{{ searchAction }}" method="get">
      <input class="lh-search-input-d5" type="search" name="{{ searchParam }}" placeholder="{{ header.search.placeholder }}" aria-label="{{ header.search.placeholder }}">
      <button class="lh-search-btn-d5" type="submit" aria-label="Search">
        <svg class="lh-search-icon-d5" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <circle cx="8.5" cy="8.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
          <line x1="13.5" y1="13.5" x2="18" y2="18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></line>
        </svg>
      </button>
    </form>

    <button class="lh-burger-d5" id="burger" type="button" aria-label="Toggle navigation" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

  </div>
</header>

<div class="lh-search-modal-d5" id="searchModal" role="dialog" aria-modal="true" aria-label="Search">
  <div class="lh-search-modal-panel-d5">
    <form class="lh-search-modal-form-d5" role="search" action="{{ searchAction }}" method="get">
      <svg class="lh-search-modal-icon-d5" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <circle cx="8.5" cy="8.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
        <line x1="13.5" y1="13.5" x2="18" y2="18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></line>
      </svg>
      <input class="lh-search-modal-input-d5" type="search" name="{{ searchParam }}" placeholder="{{ header.search.placeholder }}" aria-label="{{ header.search.placeholder }}">
    </form>
    <button class="lh-search-modal-close-d5" type="button" aria-label="Close search">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
        <line x1="4" y1="4" x2="16" y2="16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></line>
        <line x1="16" y1="4" x2="4" y2="16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></line>
      </svg>
    </button>
  </div>
</div>

<div class="lh-header-spacer-d5"></div>

<script src="{{ plugin_path('PlentyTestPlugin') }}/js/header.js"></script>
